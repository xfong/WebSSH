# ─────────────────────────────────────────────────────────────────────────────
# WebSSH Configuration File
# Copy this file to webssh.conf (in the same directory) and edit the values
# before running setup.sh. webssh.conf is gitignored; this example file is not.
# Lines starting with # are comments and are ignored by setup.sh.
#
# This branch uses PAM authentication only. User credentials are verified
# through the host machine's PAM stack (typically via SSSD), which handles
# LDAP/AD integration, caching, and local account support automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# SERVER_HOSTNAME
#   The hostname of this server. Used in two places:
#     1. As the Common Name (CN) and Subject Alternative Name (SAN) in the
#        self-signed TLS certificate generated by setup.sh.
#     2. As the root node label in the session hierarchy tree shown to users
#        and the administrator.
#   Leave blank to auto-detect using the system's `hostname` command.
#   If your server has a fully qualified domain name (FQDN) accessible to
#   users, set it here (e.g. webssh.example.com) so the TLS certificate
#   matches the address users type in their browser.
SERVER_HOSTNAME=

# ── PAM Authentication ───────────────────────────────────────────────────────

# PAM_SERVICE
#   The PAM service name used by the webssh-pam-helper to authenticate users.
#   This corresponds to a file in /etc/pam.d/ on the host machine.
#   The service defines which PAM modules are invoked (e.g. pam_sss for SSSD,
#   pam_unix for local accounts, pam_faillock for lockout policies, etc.).
#
#   Common values:
#     login    - uses /etc/pam.d/login (standard interactive login stack)
#     sshd     - uses /etc/pam.d/sshd (SSH login stack, often identical to login)
#     su       - uses /etc/pam.d/su
#
#   Use 'login' unless you have a specific reason to use a different service.
#   If left blank, the helper defaults to 'login'.
#   Default: login
PAM_SERVICE=login

# ── SSH ───────────────────────────────────────────────────────────────────────

# SSH_HOST
#   Hostname or IP address of the server that SSH terminal sessions connect to.
#   Since the backend runs inside a Docker container, use the special hostname
#   'host.docker.internal' to connect to the Docker host machine itself
#   (i.e. the server running the WebSSH containers).
#   Change this only if SSH sessions should target a different machine in your
#   cluster (e.g. a dedicated login node).
#   Default: host.docker.internal
SSH_HOST=host.docker.internal

# SSH_PORT
#   TCP port on SSH_HOST where the SSH daemon (sshd) is listening.
#   Default: 22
SSH_PORT=22

# ── Admin account ─────────────────────────────────────────────────────────────

# ADMIN_USERNAME
#   Username for the local administrator account.
#   This account is authenticated against a locally stored bcrypt hash
#   (set during setup.sh) and is completely independent of PAM.
#   The admin uses the same login page as regular users; the system detects
#   the admin username and routes them to the admin control panel.
#   Default: admin
ADMIN_USERNAME=admin

# ── Ports ─────────────────────────────────────────────────────────────────────

# HTTPS_PORT
#   The TCP port on which Nginx listens for HTTPS connections.
#   This is the port users type in their browser (e.g. https://server:8443).
#   If set to 443 (the standard HTTPS port), users do not need to specify a
#   port in the URL.
#   Note: ports below 1024 require the container to run with elevated
#   privileges, which is the default Docker behaviour.
#   Default: 443
HTTPS_PORT=443

# HTTP_PORT
#   The TCP port on which Nginx listens for plain HTTP connections.
#   All HTTP traffic is automatically redirected to HTTPS.
#   If set to 80 (the standard HTTP port), browsers that omit the port will
#   be redirected to HTTPS automatically.
#   Default: 80
HTTP_PORT=80

# XPRA_PORT_START
# XPRA_PORT_END
#   The range of TCP ports reserved for Xpra X11 session streaming.
#   Each active X11 GUI session occupies one port from this range.
#   The range must be large enough to accommodate the maximum number of
#   concurrent X11 sessions across all users.
#   Example: a range of 10000–11000 supports up to 1000 concurrent sessions.
#   Ensure these ports are not used by other services on the host.
#   Default: 10000–11000
XPRA_PORT_START=10000
XPRA_PORT_END=11000
