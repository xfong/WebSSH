# ─────────────────────────────────────────────────────────────────────────────
# WebSSH Environment Configuration
# Copy this file to .env and fill in the values before running setup.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Hostname of this server (used as the tree root label in the UI)
SERVER_HOSTNAME=webssh.local

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret key for signing JWTs. Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME

# ── Administrator Account ─────────────────────────────────────────────────────
# Username for the local admin account (not LDAP)
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate with: node -e "const b=require('bcrypt');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=CHANGE_ME

# ── LDAP ──────────────────────────────────────────────────────────────────────
# LDAP server hostname or IP
LDAP_HOST=ldap.example.com
# LDAP base DN for user search
LDAP_BASE_DN=dc=example,dc=com
# User DN template — {username} will be replaced with the login username
LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
# Path to the LDAP server's CA certificate (mounted into the app container)
LDAP_CA_CERT_PATH=/app/certs/ldap-ca.crt

# ── SSH ───────────────────────────────────────────────────────────────────────
# SSH host to connect to (defaults to Docker host — the server running containers)
SSH_HOST=host.docker.internal
SSH_PORT=22

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Xpra ──────────────────────────────────────────────────────────────────────
XPRA_HOST=xpra
# Dynamic port range allocated to per-user Xpra sessions
XPRA_PORT_START=10000
XPRA_PORT_END=11000

# ── TLS ───────────────────────────────────────────────────────────────────────
# Paths are relative to docker/nginx/ssl/ (managed by setup.sh)
TLS_CERT_FILE=server.crt
TLS_KEY_FILE=server.key
